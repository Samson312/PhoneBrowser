<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#222222"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#595959"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#2478C8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#195F9F"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#F0F7FF"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ControlBorderBrush" Color="#767676"/>

    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#DDDDDD"/>

    <SolidColorBrush x:Key="SuccessTextBrush" Color="#27804A"/>
</ResourceDictionary>