<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    
    <!-- Font sizes -->
    <sys:Double x:Key="FontSizeTitle">25</sys:Double>
    <sys:Double x:Key="FontSizeHeading">20</sys:Double>
    <sys:Double x:Key="FontSizeBody">17</sys:Double>
    <sys:Double x:Key="FontSizeSecondary">16</sys:Double>

    <!-- Screen title. -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Short instruction under the title -->
    <Style x:Key="LeadText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Important value inside a screen, e.g. folder name -->
    <Style x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Section label / field label, e.g. "Ostatnio połączone" -->
    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Secondary info: statuses, counters, paths. -->
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>