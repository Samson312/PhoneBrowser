<UserControl x:Class="PhoneBrowser.Desktop.Views.SaveLocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:PhoneBrowser.Desktop.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ScreenHeader Grid.Row="0"
            Title="{Binding Title}"
            Subtitle="Domyślnie zapiszemy je w folderze poniżej. Możesz to zmienić."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="620" VerticalAlignment="Center">

                <Border Style="{StaticResource DeviceCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding DirectoryName}"
                                   Style="{StaticResource HeadingText}" Margin="0,0,0,4"/>

                        <TextBlock Text="{Binding DisplayDirectoryPath}"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayDirectoryPath}"/>
                    </StackPanel>
                </Border>

                <controls:ErrorBanner Margin="0,0,0,16" Message="{Binding ErrorMessage}"/>

                <Button Content="Wybierz inny folder" Command="{Binding ChangeDirectoryCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <controls:NavigationButtons Grid.Row="2" Margin="0,16,0,0"
            NextText="Zapisz tutaj"
            BackCommand="{Binding BackCommand}"
            NextCommand="{Binding NextCommand}"/>
    </Grid>
</UserControl>