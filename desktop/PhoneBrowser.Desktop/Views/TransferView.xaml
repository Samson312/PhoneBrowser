<UserControl x:Class="PhoneBrowser.Desktop.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PhoneBrowser.Desktop.Views.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Title -->
            <RowDefinition Height="*" />
            <!-- Progress bar -->
            <RowDefinition Height="Auto" />
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <controls:ScreenHeader Grid.Row="0"
            Title="{Binding Title}"
            Subtitle="{Binding Description}"/>

        <ProgressBar Grid.Row="1" MaxWidth="620" VerticalAlignment="Center"
                     Maximum="{Binding TotalCount}"
                     Value="{Binding TransferredCount, Mode=OneWay}"
                     Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="2" MaxWidth="620" Margin="0,16,0,0">
            <Button Content="Anuluj" Command="{Binding BackCommand}"
                    Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}"/>
            <!-- TODO: Cancel should stay at the same page -->

            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                <Button Content="Otwórz folder ze zdjęciami" Command="{Binding OpenDirectoryCommand}" Margin="0,0,0,12"/>
                <Button Content="Zakończ" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}"/>
            </StackPanel>

            <StackPanel Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                <Button Content="Spróbuj ponownie" Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"/>
                <Button Content="Wróć i zmień folder" Command="{Binding BackCommand}" Margin="0,0,0,12"/>
                <!-- TODO: Different label and action depending on error type -->
                <Button Content="Zakończ" Command="{Binding NextCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>