<Window x:Class="PhoneBrowser.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:PhoneBrowser.Desktop.ViewModels"
        xmlns:views="clr-namespace:PhoneBrowser.Desktop.Views"
        Title="PhoneBrowser" Height="700" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:PairingViewModel}">
            <views:PairingView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InitialConfigurationViewModel}">
            <views:InitialConfigurationView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PhotoGalleryViewModel}">
            <views:PhotoGalleryView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SaveLocationViewModel}">
            <views:SaveLocationView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TransferViewModel}">
            <views:TransferView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Height="48" Background="{DynamicResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="PhoneBrowser"
                       FontSize="25"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{DynamicResource TitleBarSettingsButton}"
                    Command="{Binding OpenSettingsCommand}"
                    VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"/>
                    <TextBlock Text="Ustawienia" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        Click="OnMinimizeClick"/>

                <Button Style="{StaticResource CaptionButton}"
                        Click="OnMaximizeRestoreClick">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE922;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Text" Value="&#xE923;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                        Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" Margin="20" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
