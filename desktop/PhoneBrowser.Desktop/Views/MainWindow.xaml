<Window x:Class="PhoneBrowser.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhoneBrowser.Desktop.ViewModels"
        xmlns:views="clr-namespace:PhoneBrowser.Desktop.Views"
        Title="PhoneBrowser" Height="450" Width="800">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PairingViewModel}">
            <views:PairingView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InitialConfigurationViewModel}">
            <views:InitialConfigurationView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PhotoGalleryViewModel}">
            <views:PhotoGalleryView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
