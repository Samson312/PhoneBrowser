<UserControl x:Class="PhoneBrowser.Desktop.Views.PhotoGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controls="clr-namespace:PhoneBrowser.Desktop.Views.Controls"
             xmlns:vm="clr-namespace:PhoneBrowser.Desktop.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <Style x:Key="NewerButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Content" Value="↑ Nowsze"/>
            <Setter Property="Command" Value="{Binding NewerCommand}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanGoNewer}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OlderButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Content" Value="↓ Starsze"/>
            <Setter Property="Command" Value="{Binding OlderCommand}"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanGoOlder}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ScreenHeader Grid.Row="0" Grid.ColumnSpan="2"
            Title="Wybierz zdjęcia"
            Subtitle="Kliknij zdjęcia, żeby je zaznaczyć. Skorzystaj z listy lat i miesięcy, aby łatwo odnaleźć zdjęcia."/>

        <controls:ErrorBanner Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,16"
                              Message="{Binding ErrorMessage}"/>

        <TextBlock Grid.Row="2" Text="Wczytuję zdjęcia…"
                   Style="{StaticResource HeadingText}"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="2" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Brak zdjęć do wyświetlenia" Style="{StaticResource HeadingText}"/>
            <TextBlock Text="Sprawdź, czy aplikacja na telefonie ma dostęp do zdjęć."
                       Style="{StaticResource SecondaryText}"/>
        </StackPanel>

        <ListBox x:Name="PhotosList" Grid.Row="2"
                 ItemsSource="{Binding Rows}"
                 BorderThickness="0" Background="Transparent"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Item"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SizeChanged="OnPhotosListSizeChanged"
                 PreviewMouseWheel="OnPhotosListPreviewMouseWheel"
                 FlowDirection="RightToLeft">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="12,0" />
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="FlowDirection" Value="LeftToRight" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.Resources>
                <DataTemplate x:Key="PhotoTileTemplate">
                    <Grid>
                        <Button Style="{StaticResource PhotoTileButton}"
                                Command="{Binding ToggleCommand}"
                                AutomationProperties.Name="{Binding Photo.FileName}"
                                Margin="4"
                                Padding="0"
                                Height="250"
                                Width="250">

                            <Border CornerRadius="8"
                                    BorderThickness="4"
                                    Background="{DynamicResource PlaceholderBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Image Source="{Binding Thumbnail}"
                                            Stretch="Uniform"/>

                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="12"
                                            Width="35"
                                            Height="35"
                                            CornerRadius="7"
                                            Background="{DynamicResource AccentBrush}"
                                            BorderBrush="{DynamicResource OnAccentBrush}"
                                            BorderThickness="2"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">

                                        <TextBlock Text="✓"
                                                   Foreground="{DynamicResource OnAccentBrush}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Loaded">
                                        <i:InvokeCommandAction Command="{Binding LoadThumbnailCommand}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Border>
                        </Button>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:DayHeaderRow}">
                    <Grid Margin="0,12,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Date, StringFormat='dddd, d MMMM yyyy'}"
                                       Style="{StaticResource SectionText}"
                                       VerticalAlignment="Bottom" Margin="0"/>
                            <TextBlock Text="{Binding CountText, StringFormat=' – {0}'}"
                                       Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource CompactButton}"
                                Content="{Binding ToggleText}"
                                Command="{Binding DataContext.ToggleDayCommand,
                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding Tiles}"/>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:PhotoTilesRow}">
                    <ItemsControl ItemsSource="{Binding Tiles}"
                                  ItemTemplate="{StaticResource PhotoTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>

        <DockPanel x:Name="NavPanel" Grid.Row="2" Grid.Column="1" Width="240" Margin="16,0,0,0"
           DataContext="{Binding DateNavigation}">

            <TextBlock DockPanel.Dock="Top" Text="Przejdź do daty"
               Style="{StaticResource SectionText}" TextAlignment="Center"/>

            <Grid>
                <!-- Year level -->
                <DockPanel Visibility="{Binding IsYearLevel, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Top" Style="{StaticResource NewerButton}"/>

                    <!-- Auto scrollbar is only a safety net for very large font sizes -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Years}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CompactButton}" Margin="0,0,0,8"
                                                Command="{Binding DataContext.SelectYearCommand, ElementName=NavPanel}"
                                                CommandParameter="{Binding}">
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} – {1}">
                                                        <Binding Path="Year"/>
                                                        <Binding Path="CountText"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource OlderButton}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Month level: one button both shows the year and goes back to the years -->
                <DockPanel Visibility="{Binding IsMonthLevel, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Top" Style="{StaticResource CompactButton}" Margin="0,0,0,8"
                    Content="{Binding SelectedYear}"
                    ContentStringFormat="← {0}"
                    ToolTip="Wróć do wyboru roku"
                    Command="{Binding BackToYearsCommand}"/>
                    <Button DockPanel.Dock="Top" Style="{StaticResource NewerButton}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Months}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CompactButton}" Margin="0,0,0,8"
                                                Command="{Binding DataContext.SelectMonthCommand, ElementName=NavPanel}"
                                                CommandParameter="{Binding}">   
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} – {1}">
                                                        <Binding Path="Name"/>
                                                        <Binding Path="CountText"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource OlderButton}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>

        <controls:NavigationButtons Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0"
            BackCommand="{Binding BackCommand}"
            NextCommand="{Binding NextCommand}"
            NextText="{Binding ButtonText}"/>
    </Grid>
</UserControl>