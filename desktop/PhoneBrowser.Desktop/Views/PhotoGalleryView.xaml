<UserControl x:Class="PhoneBrowser.Desktop.Views.PhotoGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:converters="clr-namespace:PhoneBrowser.Desktop.Converters"
             xmlns:controls="clr-namespace:PhoneBrowser.Desktop.Views.Controls">

    <UserControl.Resources>
        <converters:SelectedToThicknessConverter x:Key="SelectedToThicknessConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <CollectionViewSource x:Key="GroupedPhotos" Source="{Binding Photos}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Photo.DateTakenUtc.Date" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Wybierz zdjęcia" FontSize="25" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,16" Grid.Row="0"/>

        <controls:ErrorBanner Message="{Binding ErrorMessage}" Grid.Row="1"/>

        <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Grid.Row="2">
            <TextBlock Text="Brak zdjęć do wyświetlenia"/>
            <TextBlock Text="Sprawdź, czy aplikacja na telefonie ma dostęp do zdjęć" />
        </StackPanel>

        <vwp:VirtualizingItemsControl ItemsSource="{Binding Source={StaticResource GroupedPhotos}}"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                      ScrollViewer.CanContentScroll="True"
                                      Grid.Row="2">

            
            <vwp:VirtualizingItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto"
                                  Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </vwp:VirtualizingItemsControl.Template>

            <vwp:VirtualizingItemsControl.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Grid Margin="0,12,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name, StringFormat='dd MMMM yyyy'}"
                                               FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat=' — {0} zdjęć'}"
                                               FontSize="13" Foreground="Gray" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Zaznacz dzień"
                                        Command="{Binding DataContext.ToggleDayCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Items}"/>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>

                    
                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>

                    
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <StackPanel>
                                            
                                            <ContentPresenter
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                                            <ItemsPresenter Margin="0"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </vwp:VirtualizingItemsControl.GroupStyle>

            <vwp:VirtualizingItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel />
                </ItemsPanelTemplate>
            </vwp:VirtualizingItemsControl.ItemsPanel>

            <vwp:VirtualizingItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" CornerRadius="8"
                            BorderThickness="{Binding IsSelected, Converter={StaticResource SelectedToThicknessConverter}}"
                            BorderBrush="#378add"
                            Height="250" Width="250">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding LoadThumbnailCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Button Command="{Binding ToggleCommand}"
                                BorderThickness="0" Background="Transparent" Padding="0">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                        </Button>
                    </Border>
                </DataTemplate>
            </vwp:VirtualizingItemsControl.ItemTemplate>
        </vwp:VirtualizingItemsControl>

        <Grid Margin="0,16,0,0" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Wstecz" Command="{Binding BackCommand}"/>
            <Button Grid.Column="2" Command="{Binding NextCommand}">
                <TextBlock Text="{Binding SelectedCount, StringFormat='Prześlij {0} zdjęć'}"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>