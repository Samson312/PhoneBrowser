<UserControl x:Class="PhoneBrowser.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PhoneBrowser.Desktop.Views"
             xmlns:models="clr-namespace:PhoneBrowser.Desktop.Models"
             xmlns:converters="clr-namespace:PhoneBrowser.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBool"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Jak chcesz połączyć telefon z komputerem?"
                       Style="{StaticResource TitleText}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Wybierz sposób połączenia, aby przesłać zdjęcia."
                       Style="{StaticResource LeadText}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="620" VerticalAlignment="Center">

                <RadioButton Style="{StaticResource ChoiceCard}"
                     GroupName="ConnectionMode"
                     IsChecked="{Binding Path=Mode, Mode=TwoWay,
                                 Converter={StaticResource EnumToBool},
                                 ConverterParameter={x:Static models:ConnectionMode.Wireless}}">
                    <StackPanel>
                        <TextBlock Text="Połączenie przez Wi-Fi" Style="{StaticResource HeadingText}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,6"
                           Text="Potrzebna jest aplikacja PhoneBrowser na telefonie. Telefon i komputer muszą być w tej samej sieci Wi-Fi."/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ChoiceCard}"
                     GroupName="ConnectionMode"
                     IsEnabled="False"
                     IsChecked="{Binding Path=Mode, Mode=TwoWay,
                                 Converter={StaticResource EnumToBool},
                                 ConverterParameter={x:Static models:ConnectionMode.Usb}}">
                    <StackPanel>
                        <TextBlock Text="Połączenie przez kabel USB" Style="{StaticResource HeadingText}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,6"
                           Text="Potrzebny jest kabel USB, którym podłączysz telefon do komputera. Aplikacja na telefonie nie jest wtedy wymagana."/>
                        <TextBlock Text="Niedostępne w tej wersji" Style="{StaticResource SecondaryText}"
                           FontWeight="SemiBold"/>
                    </StackPanel>
                </RadioButton>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Dalej"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding NextCommand}"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"/>
    </Grid>
</UserControl>