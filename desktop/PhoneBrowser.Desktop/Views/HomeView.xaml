<UserControl x:Class="PhoneBrowser.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PhoneBrowser.Desktop.Views"
             xmlns:models="clr-namespace:PhoneBrowser.Desktop.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Jak chcesz przesłać zdjęcia?"
            FontSize="25" FontWeight="SemiBold"
            HorizontalAlignment="Center"
            Margin="0,0,0,16"
            Grid.Row="0"/>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <RadioButton
                GroupName="ConnectionMode"
                IsChecked="True"
                Command="{Binding SelectConnectionModeCommand}"
                CommandParameter="{x:Static models:ConnectionMode.Wireless}">
                
                <StackPanel>
                    <TextBlock
                        Text="Bez kabla"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Telefon i komputer w tej samej sieci"
                        FontSize="12"
                        Foreground="#D0D0D0"/>
                </StackPanel>
            </RadioButton>
            <RadioButton
                GroupName="ConnectionMode"
                IsEnabled="False"
                Command="{Binding SelectConnectionModeCommand}"
                CommandParameter="{x:Static models:ConnectionMode.Usb}">
                <StackPanel>
                    <TextBlock
                        Text="Kabel USB"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Najprostszy i najpewniejszy sposób"
                        FontSize="12"
                        Foreground="#D0D0D0"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Button Grid.Row="2" Content="Nowy transfer" Command="{Binding NextCommand}" />
    </Grid>
</UserControl>
