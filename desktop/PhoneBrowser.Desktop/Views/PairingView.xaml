<UserControl x:Class="PhoneBrowser.Desktop.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PhoneBrowser.Desktop.Views"
             xmlns:vm="clr-namespace:PhoneBrowser.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PhoneBrowser.Desktop.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">

    <UserControl.Resources>
        <DataTemplate x:Key="KnownDeviceTemplate">
            <Border Style="{StaticResource DeviceCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Device.DeviceName}" Style="{StaticResource CardNameText}"/>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                                    <Setter Property="Text" Value="Sprawdzanie…"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:KnownDeviceStatus.Available}">
                                            <Setter Property="Text" Value="Dostępny"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:KnownDeviceStatus.Unreachable}">
                                            <Setter Property="Text" Value="Nie odpowiada"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:KnownDeviceStatus.Connected}">
                                            <Setter Property="Text" Value="Połączono"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button x:Name="ConnectButton" Grid.Column="1" Content="Połącz"
                            Style="{StaticResource PrimaryButton}" MinWidth="130"
                            Command="{Binding DataContext.ConnectCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Device}"/>

                    <Button x:Name="DisconnectButton" Grid.Column="1" Content="Rozłącz"
                            MinWidth="130" Visibility="Collapsed"
                            Command="{Binding DataContext.DisconnectCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Device}"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:KnownDeviceStatus.Connected}">
                    <Setter TargetName="ConnectButton" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DisconnectButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="NewDeviceTemplate">
            <Border Style="{StaticResource DeviceCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding DeviceName}" Style="{StaticResource CardNameText}"/>

                    <Button Grid.Column="1" Content="Paruj"
                            Style="{StaticResource PrimaryButton}" MinWidth="130"
                            Command="{Binding DataContext.PairCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWaitingForPhone}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:ScreenHeader Grid.Row="0"
                Title="Szukam telefonów w pobliżu…"
                Subtitle="Otwórz aplikację na telefonie i upewnij się, że jest w tej samej sieci Wi-Fi."/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="620">
                    <TextBlock Text="Ostatnio połączone" Style="{StaticResource SectionText}"/>
                    <ItemsControl ItemsSource="{Binding DeviceList.KnownDevices}"
                                  ItemTemplate="{StaticResource KnownDeviceTemplate}"/>

                    <TextBlock Text="Nowe urządzenia" Style="{StaticResource SectionText}" Margin="0,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding DeviceList.NewDevices}"
                                  ItemTemplate="{StaticResource NewDeviceTemplate}"/>
                </StackPanel>
            </ScrollViewer>

            <controls:ErrorBanner Grid.Row="2" Margin="0,16,0,0" Message="{Binding ErrorMessage}"/>

            <controls:NavigationButtons Grid.Row="3" Margin="0,16,0,0"
                BackCommand="{Binding BackCommand}"
                NextCommand="{Binding NextCommand}"/>
        </Grid>

        <Grid Background="{DynamicResource SurfaceBrush}"
              Visibility="{Binding IsWaitingForPhone, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="560" VerticalAlignment="Center">
                <TextBlock Text="Potwierdź połączenie na telefonie" Style="{StaticResource TitleText}"/>
                <TextBlock Text="{Binding WaitingDeviceName, StringFormat='Czekamy na odpowiedź z urządzenia {0}.'}"
                           Style="{StaticResource HeadingText}"/>
                <TextBlock Text="Jeśli ekran telefonu jest wygaszony, odblokuj go i otwórz aplikację PhoneBrowser."
                           Style="{StaticResource LeadText}"/>
                <Button Content="Anuluj" MinWidth="300" HorizontalAlignment="Center"
                        Command="{Binding CancelPairingCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>