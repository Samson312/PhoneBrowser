<UserControl x:Class="PhoneBrowser.Desktop.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PhoneBrowser.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Szukam telefonów w pobliżu…"
                FontSize="25" FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                Grid.Row="0"/>

        <TextBlock Text="Otwórz aplikację na telefonie i upewnij się, że jest w tej samej sieci Wi-Fi."
                FontSize="17" FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                Grid.Row="1"/>

        <ItemsControl ItemsSource="{Binding DevicesDiscovered}" Grid.Row="2">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding DeviceName}"
                                    VerticalAlignment="Center" FontWeight="SemiBold"/>

                            <Button Grid.Column="1" Content="Połącz"
                                Command="{Binding DataContext.PairCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,16,0,0" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Wstecz" Command="{Binding BackCommand}"/>
            <Button Grid.Column="2" Content="Dalej" Command="{Binding NextCommand}" />
        </Grid>

    </Grid>
</UserControl>
