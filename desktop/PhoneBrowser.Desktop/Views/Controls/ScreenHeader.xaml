<UserControl x:Class="PhoneBrowser.Desktop.Views.Controls.ScreenHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=root}" Style="{StaticResource TitleText}"/>
        <TextBlock Text="{Binding Subtitle, ElementName=root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource LeadText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Subtitle, ElementName=root}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>