<UserControl x:Class="PhoneBrowser.Desktop.Views.Controls.ErrorBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <Border Padding="14,12" BorderBrush="#E24B4A" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Message, ElementName=root}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚠" FontSize="22" Foreground="#791F1F"
                       VerticalAlignment="Top" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="{Binding Message.Title, ElementName=root}"
                           FontSize="17" FontWeight="SemiBold" Foreground="#791F1F"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Message.Hint, ElementName=root}"
                           FontSize="16" Foreground="#791F1F"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
